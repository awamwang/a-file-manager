{
  "name": "a-file-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A File Manager — Windows-first file manager (Tauri 2 + Vue 3)",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:tokens": "node scripts/check-fluent-tokens.mjs",
    "test:chrome": "node scripts/check-fluent-chrome.mjs",
    "test:command-panel": "node scripts/check-command-panel.mjs",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:global-search": "node scripts/check-global-search.mjs",
    "test:open-state": "node scripts/check-open-state.mjs",
    "import:sigma": "cargo run --manifest-path src-tauri/Cargo.toml --bin sigma-import --",
    "test": "npm run test:tokens && npm run test:chrome && npm run test:command-panel && npm run test:i18n && npm run test:global-search && npm run test:open-state && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.8"
  }
}
