{
  "name": "a-file-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A File Manager — Windows-first file manager (Tauri 2 + Vue 3)",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:tokens": "node scripts/check-fluent-tokens.mjs",
    "test:chrome": "node scripts/check-fluent-chrome.mjs",
    "test:fluent-icons": "node scripts/check-fluent-icons.mjs",
    "test:fluent-p1": "node scripts/check-fluent-p1-color.mjs",
    "test:fluent-p2": "node scripts/check-fluent-p2-primitives.mjs",
    "test:fluent-p3": "node scripts/check-fluent-p3-icons.mjs",
    "test:fluent-p4": "node scripts/check-fluent-p4-depth.mjs",
    "test:command-panel": "node scripts/check-command-panel.mjs",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:global-search": "node scripts/check-global-search.mjs",
    "test:open-state": "node scripts/check-open-state.mjs",
    "test:nav-ia": "node scripts/check-nav-ia.mjs",
    "test:shortcuts": "node scripts/check-shortcuts.mjs",
    "test:context-menu": "node scripts/check-context-menu.mjs",
    "test:autostart": "node scripts/check-autostart.mjs",
    "test:discovery-search": "node scripts/check-discovery-search.mjs",
    "test:file-ops": "node scripts/check-file-ops.mjs",
    "test:nav-history": "node scripts/check-nav-history.mjs",
    "test:list-select": "node scripts/check-list-select.mjs",
    "test:shell-icons": "node scripts/check-shell-icons.mjs",
    "test:favorites-sidebar": "node scripts/check-favorites-sidebar.mjs",
    "test:favorites-shell-verb": "node scripts/check-favorites-shell-verb.mjs",
    "test:dual-pane": "node scripts/check-dual-pane.mjs",
    "test:discovery-unify": "node scripts/check-discovery-unify.mjs",
    "test:dark-theme": "node scripts/check-dark-theme-walkthrough.mjs",
    "test:visit-stats": "node scripts/check-visit-stats.mjs",
    "test:provider-cache": "node scripts/check-provider-cache.mjs",
    "test:navigator-status-bar": "node scripts/check-navigator-status-bar.mjs",
    "test:window-controls": "node scripts/check-window-controls.mjs",
    "test:navigator-chrome-layout": "node scripts/check-navigator-chrome-layout.mjs",
    "test:navigator-wg-chrome": "node scripts/check-navigator-wg-chrome.mjs",
    "test:navigator-icon-split": "node scripts/check-navigator-icon-split.mjs",
    "test:search-status-doc": "node scripts/check-search-status-doc.mjs",
    "import:sigma": "cargo run --manifest-path src-tauri/Cargo.toml --bin sigma-import --",
    "test": "npm run test:tokens && npm run test:chrome && npm run test:fluent-icons && npm run test:fluent-p1 && npm run test:fluent-p2 && npm run test:fluent-p3 && npm run test:fluent-p4 && npm run test:command-panel && npm run test:i18n && npm run test:global-search && npm run test:open-state && npm run test:nav-ia && npm run test:shortcuts && npm run test:context-menu && npm run test:autostart && npm run test:discovery-search && npm run test:file-ops && npm run test:nav-history && npm run test:list-select && npm run test:shell-icons && npm run test:favorites-sidebar && npm run test:favorites-shell-verb && npm run test:dual-pane && npm run test:discovery-unify && npm run test:dark-theme && npm run test:visit-stats && npm run test:provider-cache && npm run test:navigator-status-bar && npm run test:window-controls && npm run test:navigator-chrome-layout && npm run test:navigator-wg-chrome && npm run test:navigator-icon-split && npm run test:search-status-doc && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.8"
  }
}
